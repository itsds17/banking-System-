# ==============================================================================
# Environment Variables — EXAMPLE FILE
# Copy this to .env and fill in values. NEVER commit .env to version control.
# ==============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=banking_db
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=change_me_in_production

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRANSACTION_TOPIC=banking.transactions
KAFKA_FRAUD_ALERT_TOPIC=banking.fraud_alerts
KAFKA_GROUP_ID=banking_consumer_group

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_FRAUD=fraud_detection
MLFLOW_EXPERIMENT_CREDIT=credit_risk_modelling
MLFLOW_EXPERIMENT_SEGMENTATION=customer_segmentation

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
API_LOG_LEVEL=info

# ── Data Generation ───────────────────────────────────────────────────────────
DATA_CONFIG_PATH=config/data_config.yaml
DATA_OUTPUT_DIR=data/synthetic
RANDOM_SEED=42

# ── PySpark ───────────────────────────────────────────────────────────────────
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=1g
SPARK_APP_NAME=BankingDecisionIntelligence

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
